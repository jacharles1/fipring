# Copy to .env and fill in. Never commit .env.

POSTGRES_PASSWORD=change-me
# Your timezone, so nights and days line up with your clock.
TZ=America/New_York

# --- collector (only if the homelab syncs the ring itself) ---
# Folder holding ring.key (created by `python -m ring.cli pair`).
OURA_KEY_DIR=~/.fipring
# The ring's Bluetooth address. Optional; without it the strongest Oura ring nearby is used.
OURA_RING_ADDRESS=
SYNC_EVERY_MINUTES=30
