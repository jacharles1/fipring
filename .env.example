# Copy to .env and fill in. Never commit .env.

# Oura developer app (https://developer.ouraring.com -> create an application)
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
# Must exactly match a redirect URI registered on your Oura app.
OURA_REDIRECT_URI=http://localhost:8000/auth/callback

# Postgres (docker-compose creates this database)
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://oura:change-me@db:5432/oura

# How many days to backfill on the first sync, and how often to re-sync.
BACKFILL_DAYS=365
SYNC_INTERVAL_MINUTES=60

# Optional: your ring's MAC address for the ble/ tools (from the Oura app's Ring details screen).
OURA_RING_MAC=
